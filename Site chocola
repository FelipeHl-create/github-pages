<script>
function comprar(nomeProduto) {
    const quantidade = prompt(`Quantas unidades de ${nomeProduto} você deseja comprar?`);
    
    if (quantidade && !isNaN(quantidade) && quantidade > 0) {
        const aviso = document.createElement('div');
        aviso.className = 'aviso';
        aviso.textContent = `${quantidade} unidade(s) de ${nomeProduto} adicionado(s) ao carrinho!`;
        
        const produto = event.target.closest('.produto');
        produto.appendChild(aviso);
        
        aviso.style.display = 'block';
        
        setTimeout(() => {
            aviso.style.display = 'none';
            setTimeout(() => {
                aviso.remove();
            }, 500);
        }, 3000);
    }
}

// Adiciona botões de comprar a todos os produtos
document.querySelectorAll('.produto').forEach(produto => {
    const nomeProduto = produto.querySelector('h3').textContent;
    const botao = document.createElement('button');
    botao.className = 'botao-comprar';
    botao.textContent = 'Comprar';
    botao.onclick = () => comprar(nomeProduto);
    produto.appendChild(botao);
});
</script>

