</body>
<script>
    // Array para armazenar itens do carrinho
    let carrinhoItens = [];

    // Adicionar eventos aos botões de compra
    document.querySelectorAll('.btn-comprar').forEach(botao => {
        botao.addEventListener('click', function() {
            const produto = this.parentElement;
            const item = {
                nome: produto.querySelector('h3').textContent,
                preco: produto.querySelector('.preco').textContent,
                imagem: produto.querySelector('img').src
            };
            carrinhoItens.push(item);
            atualizarCarrinho();
            alert('Produto adicionado ao carrinho!');
        });
    });

    function atualizarCarrinho() {
        const contador = document.querySelector('.carrinho-contador');
        contador.textContent = carrinhoItens.length;
    }

    function abrirCarrinho() {
        if (carrinhoItens.length === 0) {
            alert('Seu carrinho está vazio!');
            return;
        }

        let total = 0;
        let listaItens = 'Itens no carrinho:\n\n';
        carrinhoItens.forEach(item => {
            listaItens += `${item.nome} - ${item.preco}\n`;
            total += parseFloat(item.preco.replace('R$ ', '').replace(',', '.'));
        });

        if (confirm(`${listaItens}\nTotal: R$ ${total.toFixed(2)}\n\nDeseja finalizar a compra?`)) {
            const formaPagamento = prompt('Escolha a forma de pagamento:\n1 - Cartão de Crédito\n2 - PIX\n3 - Boleto');
            alert('Compra finalizada com sucesso!');
            carrinhoItens = [];
            atualizarCarrinho();
        }
    }
</script>

